import {
  "youyong5/feedlens",
  "youyong5/feedlens/cmd/render",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

options(
  "native-stub": [ "stderr.c" ],
  targets: {
    "stderr_native.mbt": [ "native", "llvm" ],
    "stderr_js.mbt": [ "js" ],
    "stderr_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
)
